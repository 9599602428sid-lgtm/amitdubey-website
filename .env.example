# Optional. Defaults to ./data, then OS temp on read-only hosts (e.g. Netlify).
DATA_DIR=

# 32-byte key as 64 hex characters. Required in production.
# Used to seal investigation form payloads (AES-256-GCM) before they are stored.
CASE_ENCRYPTION_KEY=

# Server-only Supabase access. Never prefix these with NEXT_PUBLIC_.
# The browser form does not talk to Supabase; only this Next.js server does,
# using the service_role secret. Dashboard → Project Settings → API.
SUPABASE_URL=https://sylyhcjookygtiajcygi.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email. If unset, acknowledgements are written to data/mail/ for local testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Investigations <investigations@cyberdubey.co.uk>"
NOTIFY_EMAIL=

# Public contact shown on legal pages
CONTACT_EMAIL=investigations@cyberdubey.co.uk

# Staff review area
STAFF_USERNAME=reviewer
STAFF_PASSWORD=
# Base32 TOTP secret. Required for /internal. Generate with: node -e "console.log(require('otpauth').Secret.fromHex(require('crypto').randomBytes(20).toString('hex')).base32)"
STAFF_TOTP_SECRET=
SESSION_SECRET=

# Optional ClamAV socket, e.g. /var/run/clamav/clamd.ctl
CLAMAV_SOCKET=
